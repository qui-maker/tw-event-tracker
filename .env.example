# 複製這個檔案成 .env，填入自己的值。.env 已經列在 .gitignore，不會被上傳。
# 正式環境不用 .env：自動排程讀 GitHub Secrets，網站讀 Streamlit Cloud 的 Secrets。

# Supabase 資料庫連線（Session pooler 網址，含密碼）——只有自動排程需要，網站不需要
DATABASE_URL=postgresql://postgres.xxxxxxxx:你的密碼@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# Supabase 網站讀取用（Project URL 與 publishable／anon 唯讀金鑰）
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# 美國聯準會經濟資料庫 FRED（免費申請）
FRED_API_KEY=

# AI：預設 gemini；要改用 Claude 就設 AI_PROVIDER=claude 並填 ANTHROPIC_API_KEY（付費）
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
